%%BeginSetup
%%EndSetup
%%Page: 1 1
%%BeginPageSetup
%%PageBoundingBox: 0 1 482 139
%%EndPageSetup
q 0 1 482 138 rectclip
1 0 0 -1 0 139 cm q
